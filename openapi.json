  "info": {
    "title": "Kvik Backend API",
    "description": "AI SaaS Sales Agent for Kazakhstan and CIS Market",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "OnboardingStateResponseDto": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "SELECT_NICHE",
              "BUSINESS_PROFILE",
              "DATA_SOURCE",
              "DATA_PREVIEW",
              "CONNECT_CHANNEL",
              "QUALIFICATION",
              "COMPLETE_TEST",
              "DONE"
            ],
            "example": "DATA_PREVIEW"
          },
          "stepIndex": {
            "type": "number",
            "example": 3,
            "description": "0..7"
          },
          "completed": {
            "type": "boolean",
            "example": false
          },
          "parsingStatus": {
            "type": "string",
            "enum": [
              "IDLE",
              "QUEUED",
              "PROCESSING",
              "DONE",
              "FAILED"
            ],
            "description": "Только на шагах DATA_SOURCE и DATA_PREVIEW"
          },
          "parsedCount": {
            "type": "number",
            "example": 12
          },
          "totalCount": {
            "type": "number",
            "example": 47
          },
          "failedCount": {
            "type": "number",
            "example": 1
          },
          "error": {
            "type": "string",
            "description": "Заполнено при parsingStatus === FAILED",
            "example": "All listings failed to parse"
          }
        },
        "required": [
          "step",
          "stepIndex",
          "completed"
        ]
      },
      "SelectNicheDto": {
        "type": "object",
        "properties": {
          "nicheProfile": {
            "type": "string",
            "enum": [
              "REALTY",
              "AUTO_SALES",
              "AUTO_SERVICE",
              "BEAUTY",
              "CLINIC",
              "OTHER_CALENDAR"
            ]
          }
        },
        "required": [
          "nicheProfile"
        ]
      },
      "BusinessProfileDto": {
        "type": "object",
        "properties": {}
      },
      "DataSourceDto": {
        "type": "object",
        "properties": {}
      },
      "DataSourceResponseDto": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "SELECT_NICHE",
              "BUSINESS_PROFILE",
              "DATA_SOURCE",
              "DATA_PREVIEW",
              "CONNECT_CHANNEL",
              "QUALIFICATION",
              "COMPLETE_TEST",
              "DONE"
            ],
            "example": "DATA_PREVIEW"
          },
          "stepIndex": {
            "type": "number",
            "example": 3,
            "description": "0..7"
          },
          "completed": {
            "type": "boolean",
            "example": false
          },
          "parsingStatus": {
            "type": "string",
            "enum": [
              "IDLE",
              "QUEUED",
              "PROCESSING",
              "DONE",
              "FAILED"
            ],
            "description": "Только на шагах DATA_SOURCE и DATA_PREVIEW"
          },
          "parsedCount": {
            "type": "number",
            "example": 12
          },
          "totalCount": {
            "type": "number",
            "example": 47
          },
          "failedCount": {
            "type": "number",
            "example": 1
          },
          "error": {
            "type": "string",
            "description": "Заполнено при parsingStatus === FAILED",
            "example": "All listings failed to parse"
          },
          "code": {
            "type": "string",
            "example": "onboarding.parsing_started"
          },
          "message": {
            "type": "string",
            "example": "Parsing started. Your listings will be ready in a few minutes. You can proceed to the next step."
          },
          "isRaw": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "step",
          "stepIndex",
          "completed",
          "code",
          "message"
        ]
      },
      "DataPreviewResponseDto": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Первые 20 распарсенных объектов (KnowledgeEntry) для превью"
          },
          "parsingStatus": {
            "type": "string",
            "enum": [
              "IDLE",
              "QUEUED",
              "PROCESSING",
              "DONE",
              "FAILED"
            ],
            "example": "PROCESSING"
          },
          "parsedCount": {
            "type": "number",
            "example": 12,
            "description": "Успешно распарсено (авторитетно)"
          },
          "totalCount": {
            "type": "number",
            "example": 47,
            "description": "Ожидается всего по матрице обхода"
          },
          "failedCount": {
            "type": "number",
            "example": 1
          },
          "error": {
            "type": "string",
            "description": "Заполнено при parsingStatus === FAILED"
          }
        },
        "required": [
          "entries",
          "parsingStatus",
          "parsedCount",
          "totalCount",
          "failedCount"
        ]
      },
      "ConnectChannelDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "WHATSAPP",
              "INSTAGRAM",
              "TELEGRAM"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "QualificationDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}